# Manual PostgreSQL image for local development and integration tests.
#
# Quarkus Dev Services normally starts PostgreSQL through Testcontainers when
# no JDBC URL is configured. In this project that startup failed before the
# container could be created because Testcontainers could not find a usable
# Docker environment (for example, Docker Desktop was not running or the
# configured Docker socket was incorrect). The error mentions
# DevServicesDatasourceProcessor#launchDatabases, but the root cause is the
# Docker environment, not the PostgreSQL image.
#
# This image is therefore started manually and the test datasource points to
# localhost:15432. Build and run it from the java-assignment directory:
#
#   docker build -f src/main/docker/Dockerfile.postgresql -t fcs-postgresql .
#   docker run --name fcs-postgresql -p 15432:5432 -d fcs-postgresql
#
# For IntelliJ's Dockerfile run configuration, set the port binding to:
#
#   15432:5432
#
# Dockerfile instructions cannot define the host port mapping themselves.
#
# EXPOSE documents the container port; -p in `docker run` publishes it on the
# host where the Quarkus tests run.
FROM postgres:14

ENV POSTGRES_DB=quarkus_test \
    POSTGRES_USER=quarkus_test \
    POSTGRES_PASSWORD=quarkus_test

EXPOSE 5432
